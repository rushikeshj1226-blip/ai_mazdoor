---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PostCard from '@/components/PostCard.astro';
import { getPosts, formatDate, readingTime, type Post } from '@/utils/blog';
import { site, waLink } from '@/data/site';
import { lower } from '@/data/services';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props as { post: Post; posts: Post[] };
const { Content, headings } = await render(post);
const { title, seoTitle, description, hi, category, pubDate, updatedDate, keywords } = post.data;
const related = posts.filter((p) => p.id !== post.id).slice(0, 2);
const toc = headings.filter((h) => h.depth === 2);
const serviceLink = { 'AI Automation': '/services/ai-automation', 'Website Design': '/services/website-design', 'Logo Design': '/services/logo-design' }[category];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: `${site.url}/blog/${post.id}`,
  mainEntityOfPage: `${site.url}/blog/${post.id}`,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: 'en-IN',
  keywords: keywords.join(', '),
  articleSection: category,
  image: `${site.url}${site.ogImage}`,
  author: { '@type': 'Organization', name: site.name, url: site.url },
  publisher: { '@id': `${site.url}/#organization` },
};
---

<BaseLayout
  title={seoTitle ?? `${title} | AI Mazdoor`}
  description={description}
  type="article"
  keywords={keywords}
  publishedTime={pubDate.toISOString()}
  modifiedTime={(updatedDate ?? pubDate).toISOString()}
  schema={[articleSchema]}
>
  <article>
    <header class="relative overflow-hidden pt-28 pb-12 sm:pt-36 sm:pb-16">
      <div class="bg-grid mask-fade-b pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="container-x relative max-w-6xl! [&>*:not(nav)]:max-w-4xl">
        <Breadcrumbs items={[{ label: 'Blog', href: '/blog' }, { label: category }]} />
        <p class="rise eyebrow mt-8 flex flex-wrap items-center gap-2 text-muted" style="--i:0">
          <a href={serviceLink} class="rounded-full border-2 border-ink bg-orange px-3 py-1 text-ink">{category}</a>
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time> · {readingTime(post.body)} min read
        </p>
        <h1 class="rise mt-6 text-[clamp(2.1rem,1.5rem+2.8vw,3.8rem)] leading-[1.05] font-extrabold" style="--i:1">{title}</h1>
        <p class="display-hi rise mt-5 text-[clamp(1.4rem,1.1rem+1.2vw,2rem)] text-orange-deep" lang="hi" style="--i:2">{hi}</p>
        <p class="rise mt-5 text-lg leading-relaxed text-muted" style="--i:3">{description}</p>
      </div>
    </header>

    <div class="container-x grid max-w-6xl! gap-12 pb-20 lg:grid-cols-[1fr_16rem]">
      <div class="prose-am max-w-3xl min-w-0">
        <Content />
      </div>
      <aside class="hidden lg:block">
        <div class="sticky top-28 space-y-6">
          {
            toc.length > 0 && (
              <nav aria-label="On this page" class="rounded-[1.4rem] border-2 border-ink bg-white p-5">
                <p class="eyebrow text-muted">On this page</p>
                <ol class="mt-3 space-y-2 text-sm">
                  {toc.map((h) => (
                    <li><a href={`#${h.slug}`} class="link-underline font-medium hover:text-orange-deep">{h.text}</a></li>
                  ))}
                </ol>
              </nav>
            )
          }
          <div class="rounded-[1.4rem] border-2 border-ink bg-ink p-5 text-white shadow-[5px_5px_0_var(--color-orange)]">
            <p class="display-hi text-2xl" lang="hi">मदद चाहिए?</p>
            <p class="mt-2 text-sm text-muted-dark">Talk to us about {lower(category)} — free 20-minute call.</p>
            <a href={waLink(`Namaste! Maine aapka blog "${title}" padha. Mujhe ${category} ke baare mein baat karni hai.`)} target="_blank" rel="noopener" class="btn btn-primary mt-4 min-h-11! w-full px-4! text-sm!">WhatsApp us →</a>
          </div>
        </div>
      </aside>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="bg-orange-tint py-20" aria-labelledby="related-title">
        <div class="container-x">
          <h2 id="related-title" class="text-[clamp(1.8rem,1.4rem+1.6vw,2.6rem)] font-extrabold" data-reveal>Keep reading <span class="hi text-orange-deep" lang="hi">· और पढ़ें</span></h2>
          <div class="mt-10 grid gap-6 md:grid-cols-2">
            {related.map((p, i) => <PostCard post={p} index={i} />)}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
