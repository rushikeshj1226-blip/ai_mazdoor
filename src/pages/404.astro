---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { serviceLinks } from '@/data/site';
---

<BaseLayout title="Page not found | AI Mazdoor" description="This page does not exist. Explore AI Mazdoor's logo design, website design and AI automation services." noindex>
  <section class="relative overflow-hidden pt-36 pb-24 sm:pt-44">
    <div class="bg-grid mask-fade-b pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-x relative text-center">
      <p class="rise text-[clamp(7rem,5rem+12vw,15rem)] leading-none font-extrabold tracking-tighter" style="--i:0">
        4<span class="inline-block animate-spin-slow text-orange">✦</span>4
      </p>
      <h1 class="mt-4">
        <span class="display-hi rise block text-[clamp(2.2rem,1.6rem+3vw,4rem)]" lang="hi" style="--i:1">अरे! ये पेज छुट्टी पर है।</span>
        <span class="rise mt-3 block text-xl font-bold text-muted" style="--i:2">This page took a chai break. Let’s get you back to work.</span>
      </h1>
      <div class="rise mt-10 flex flex-wrap justify-center gap-3" style="--i:3">
        <a href="/" class="btn btn-primary">Back to home <span class="arrow" aria-hidden="true">→</span></a>
        {serviceLinks.map((c) => <a href={c.href} class="btn btn-ghost">{c.label}</a>)}
      </div>
    </div>
  </section>
</BaseLayout>
