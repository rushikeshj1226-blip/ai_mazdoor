---
import { site } from '@/data/site';
import { cleanPath } from '@/utils/path';

export interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  keywords?: string[];
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  image = site.ogImage,
  imageAlt = `${site.name} — ${site.tagline}`,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  keywords = [],
  schema = [],
} = Astro.props;

const canonical = new URL(cleanPath(Astro.url.pathname), Astro.site);
const ogImage = new URL(image, Astro.site).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#organization`,
  name: site.name,
  alternateName: site.altNames,
  url: site.url,
  logo: `${site.url}/icons/icon-512.png`,
  image: `${site.url}${site.ogImage}`,
  description: site.description,
  email: site.email,
  telephone: site.phoneRaw,
  areaServed: [{ '@type': 'Country', name: 'India' }, 'Worldwide'],
  address: { '@type': 'PostalAddress', addressCountry: site.region },
  knowsLanguage: ['en-IN', 'hi-IN'],
  ...(site.showFounders
    ? { founder: site.founders.map((f) => ({ '@type': 'Person', name: f.name, alternateName: f.nameHi, jobTitle: f.role })) }
    : {}),
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '10:00',
    closes: '19:00',
  },
  // Add real social profile URLs here once they exist — they help Google link the brand to them
  // sameAs: [],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Design & AI Automation Services',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Logo Design', url: `${site.url}/services/logo-design` } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Website Design', url: `${site.url}/services/website-design` } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI Automation', url: `${site.url}/services/ai-automation` } },
    ],
  },
};

const graph = [organization, ...schema];
---

<title>{title}</title>
<meta name="description" content={description} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<link rel="canonical" href={canonical.href} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
<meta name="author" content={site.name} />
<meta name="geo.region" content="IN" />
<link rel="alternate" hreflang="en-IN" href={canonical.href} />
<link rel="alternate" hreflang="x-default" href={canonical.href} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<script type="application/ld+json" set:html={JSON.stringify(graph.length === 1 ? graph[0] : graph)} />
