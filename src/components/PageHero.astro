---
import Breadcrumbs from './Breadcrumbs.astro';
import Bi from './Bi.astro';

export interface Props {
  label: string;
  hi: string;
  title: string;
  text?: string;
  crumbs: { label: string; href?: string }[];
}
const { label, hi, title, text, crumbs } = Astro.props;
const words = hi.split(' ');
---

<section class="relative overflow-hidden pt-32 pb-16 sm:pt-40 sm:pb-20">
  <div class="bg-grid mask-fade-b pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="blob pointer-events-none absolute -top-40 -right-40 size-[34rem] rounded-full bg-orange/25 blur-3xl" aria-hidden="true"></div>
  <div class="container-x relative">
    <Breadcrumbs items={crumbs} />
    <p class="eyebrow mt-8 inline-flex items-center gap-2 rounded-full border-2 border-ink bg-white px-3 py-1.5 text-ink">
      <span class="size-2 rounded-full bg-orange" aria-hidden="true"></span><span><Bi text={label} /></span>
    </p>
    <h1 class="mt-6 max-w-5xl">
      <span class="display-hi block text-[clamp(2.9rem,1.8rem+5.4vw,6.4rem)]" lang="hi">
        {words.map((w, i) => <><span class="rise" style={`--i:${i}`}>{w}</span>{i < words.length - 1 && ' '}</>)}
      </span>
      <span class="rise mt-4 block max-w-3xl text-[clamp(1.4rem,1.1rem+1.4vw,2.4rem)] font-extrabold leading-[1.1]" style={`--i:${words.length}`}>{title}</span>
    </h1>
    {text && <p class="rise mt-6 max-w-2xl text-lg leading-relaxed text-muted" style={`--i:${words.length + 1}`}>{text}</p>}
    <slot />
  </div>
</section>

<style>
  .blob {
    animation: float 9s ease-in-out infinite;
  }
</style>
