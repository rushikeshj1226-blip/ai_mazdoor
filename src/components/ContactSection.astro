---
import { site, socialLinks, waLink } from '@/data/site';

export interface Props {
  num?: string;
  heading?: 'h1' | 'h2';
  preset?: 'Logo Design' | 'Website Design' | 'AI Automation';
}
const { num = '', heading = 'h2', preset } = Astro.props;
const Heading = heading;
const options = [
  { value: 'Logo Design', hi: 'लोगो' },
  { value: 'Website Design', hi: 'वेबसाइट' },
  { value: 'AI Automation', hi: 'AI बॉट' },
  { value: 'Not sure yet', hi: 'पता नहीं' },
];
---

<section id="contact" class="relative overflow-hidden py-20 sm:py-28" aria-labelledby="contact-title">
  <div class="bg-grid mask-fade-b pointer-events-none absolute inset-0 opacity-70" aria-hidden="true"></div>
  <div class="container-x relative grid items-start gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
    <div data-reveal>
      <p class="eyebrow flex items-center gap-3 text-muted">
        {num && <span class="text-orange">{num}</span>}<span class="h-px w-8 bg-current opacity-60" aria-hidden="true"></span>Let’s talk · <span lang="hi">संपर्क</span>
      </p>
      <Heading id="contact-title" class="mt-5">
        <span class="display-hi block text-[clamp(3rem,2rem+5vw,6rem)]" lang="hi">आइए, <span class="hl">बात</span> करते हैं।</span>
        <span class="mt-3 block text-[clamp(1.35rem,1.1rem+1.1vw,2.1rem)] font-extrabold leading-tight">Tell us what you need — we’ll reply with a clear plan and timeline.</span>
      </Heading>
      <p class="mt-5 max-w-lg text-lg leading-relaxed text-muted">
        Free 20-minute consultation in Hindi or English. No sales pressure — if we are not the right fit, we will tell you honestly.
      </p>

      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        <li>
          <a href={waLink()} target="_blank" rel="noopener" class="group flex items-center gap-3 rounded-2xl border-2 border-ink bg-white p-4 transition-all duration-300 hover:-translate-y-1 hover:shadow-[4px_4px_0_var(--color-ink)]">
            <span class="grid size-11 place-items-center rounded-xl bg-[#25D366] text-white" aria-hidden="true">
              <svg class="size-6" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3ZM12 21.8a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.8Zm8.4-18.2A11.8 11.8 0 0 0 1.8 17.9L.1 24l6.3-1.7A11.8 11.8 0 0 0 24 12c0-3.2-1.2-6.1-3.5-8.4Z" /></svg>
            </span>
            <span><span class="block text-xs font-semibold text-muted">WhatsApp</span><span class="font-bold">{site.phone}</span></span>
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`} class="group flex items-center gap-3 rounded-2xl border-2 border-ink bg-white p-4 transition-all duration-300 hover:-translate-y-1 hover:shadow-[4px_4px_0_var(--color-ink)]">
            <span class="grid size-11 place-items-center rounded-xl bg-orange text-ink" aria-hidden="true">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4.5" width="19" height="15" rx="2.5" /><path d="m3 6 9 7 9-7" /></svg>
            </span>
            <span class="min-w-0"><span class="block text-xs font-semibold text-muted">Email</span><span class="block truncate font-bold">{site.email}</span></span>
          </a>
        </li>
        <li class="flex items-center gap-3 rounded-2xl border-2 border-ink bg-white p-4 sm:col-span-2">
          <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-ink text-orange" aria-hidden="true">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h3l2 5-2.5 1.5a11 11 0 0 0 5 5L14 12l5 2v3a2 2 0 0 1-2 2A15 15 0 0 1 3 5a2 2 0 0 1 2-2Z" /></svg>
          </span>
          <span class="min-w-0">
            <span class="block text-xs font-semibold text-muted">Call · <span class="hi" lang="hi">कॉल करें</span></span>
            <span class="flex flex-wrap gap-x-2 font-bold">
              <a href={`tel:${site.phoneRaw}`} class="link-underline hover:text-orange-deep">{site.phone}</a>
              <span class="text-muted" aria-hidden="true">/</span>
              <a href={`tel:${site.phone2Raw}`} class="link-underline hover:text-orange-deep">{site.phone2}</a>
            </span>
          </span>
        </li>
        {
          socialLinks.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener me" class="group flex items-center gap-3 rounded-2xl border-2 border-ink bg-white p-4 transition-all duration-300 hover:-translate-y-1 hover:shadow-[4px_4px_0_var(--color-ink)]">
                <span class="grid size-11 shrink-0 place-items-center rounded-xl text-white" style={`background: ${s.bg}`} aria-hidden="true">
                  <svg class="size-6" viewBox="0 0 24 24" fill="currentColor"><path d={s.icon} /></svg>
                </span>
                <span class="min-w-0"><span class="block text-xs font-semibold text-muted">{s.label}</span><span class="block truncate font-bold">{s.handle}</span></span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 flex items-center gap-2 text-sm font-semibold text-muted">
        <span class="relative flex size-2.5"><span class="absolute inset-0 animate-ping rounded-full bg-[#25D366] opacity-70"></span><span class="relative size-2.5 rounded-full bg-[#25D366]"></span></span>
        Usually replies within 2 working hours · {site.hours}
      </p>
    </div>

    <form class="card-hard relative p-6 sm:p-8" data-contact-form data-whatsapp={site.whatsapp} data-endpoint={site.formEndpoint} data-reveal="right" novalidate>
      <fieldset>
        <legend class="mb-3 text-sm font-bold">I need help with · <span class="hi" lang="hi">मुझे चाहिए</span></legend>
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
          {
            options.map((o, i) => (
              <label class="opt relative cursor-pointer">
                <input type="radio" name="service" value={o.value} class="peer sr-only" checked={preset ? preset === o.value : i === 0} />
                <span class="flex h-full flex-col items-center justify-center rounded-2xl border-2 border-ink/15 bg-paper px-2 py-3 text-center transition-all duration-200 peer-checked:border-ink peer-checked:bg-orange peer-checked:shadow-[3px_3px_0_var(--color-ink)] peer-focus-visible:outline-3 peer-focus-visible:outline-orange hover:border-ink">
                  <span class="hi text-base font-bold leading-tight" lang="hi">{o.hi}</span>
                  <span class="text-[0.72rem] font-semibold opacity-75">{o.value}</span>
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <label class="field">
          <span>Name · <span class="hi" lang="hi">नाम</span></span>
          <input type="text" name="name" autocomplete="name" required minlength="2" placeholder="Your name" />
        </label>
        <label class="field">
          <span>WhatsApp number</span>
          <input type="tel" name="phone" autocomplete="tel" inputmode="tel" required pattern="[+]?[0-9 \-]{10,15}" placeholder="+91 98XXX XXXXX" />
        </label>
        <label class="field sm:col-span-2">
          <span>Business & city · <span class="hi" lang="hi">बिज़नेस</span></span>
          <input type="text" name="business" autocomplete="organization" placeholder="e.g. Dental clinic, Pune" />
        </label>
        <label class="field sm:col-span-2">
          <span>Tell us a little more <span class="font-normal text-muted">(optional)</span></span>
          <textarea name="message" rows="3" placeholder="Goals, deadline, budget — whatever you know so far."></textarea>
        </label>
      </div>

      <p class="mt-3 hidden text-sm font-semibold text-orange-deep" data-error role="alert">Please enter your name and a valid WhatsApp number.</p>

      <button type="submit" class="btn btn-primary mt-6 w-full text-[1.05rem]!">
        <span data-label>Send enquiry · <span class="hi" lang="hi">भेजें</span></span> <span class="arrow" aria-hidden="true">→</span>
      </button>
      <p class="mt-4 text-center text-xs leading-relaxed text-muted">
        We only use your details to reply about your project. No spam, ever. <a href="/privacy" class="underline underline-offset-2">Privacy policy</a>
      </p>

      <div class="success absolute inset-0 hidden flex-col items-center justify-center rounded-[1.4rem] bg-white p-8 text-center" data-success role="status">
        <span class="grid size-16 place-items-center rounded-full border-2 border-ink bg-orange text-2xl">✓</span>
        <p class="display-hi mt-5 text-4xl" lang="hi">धन्यवाद!</p>
        <p class="mt-2 max-w-xs text-muted">Thanks — we’ve got your enquiry and will reply on WhatsApp soon.</p>
      </div>
    </form>
  </div>
</section>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .field input,
  .field textarea {
    width: 100%;
    border: 2px solid rgb(20 18 16 / 0.15);
    border-radius: 0.9rem;
    background: var(--color-paper);
    padding: 0.85rem 1rem;
    font-size: 1rem;
    font-weight: 500;
    transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }
  .field textarea { resize: vertical; min-height: 6rem; }
  .field input:hover,
  .field textarea:hover { border-color: rgb(20 18 16 / 0.4); }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-ink);
    background: #fff;
    box-shadow: 3px 3px 0 var(--color-orange);
  }
  .field input:user-invalid { border-color: var(--color-orange-deep); }
  .success.show { display: flex; animation: pop 0.5s var(--ease-out-expo); }
</style>

<script>
  // WhatsApp number and endpoint come from data attributes, so the browser only gets what it needs
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const whatsapp = form.dataset.whatsapp ?? '';
    const endpoint = form.dataset.endpoint ?? '';
    const error = form.querySelector<HTMLElement>('[data-error]')!;
    const success = form.querySelector<HTMLElement>('[data-success]')!;
    const label = form.querySelector<HTMLElement>('[data-label]')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        error.classList.remove('hidden');
        form.querySelector<HTMLInputElement>(':invalid')?.focus();
        return;
      }
      error.classList.add('hidden');
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;

      if (endpoint) {
        label.textContent = 'Sending…';
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ ...data, page: location.pathname }),
          });
          if (!res.ok) throw new Error(String(res.status));
          success.classList.add('show');
          form.reset();
        } catch {
          label.textContent = 'Could not send — try WhatsApp';
        }
        return;
      }

      // No form backend configured: hand the enquiry to WhatsApp, pre-filled.
      const text = [
        'Namaste AI Mazdoor! 🙏',
        `Service: ${data.service}`,
        `Name: ${data.name}`,
        `Phone: ${data.phone}`,
        data.business && `Business: ${data.business}`,
        data.message && `Details: ${data.message}`,
      ].filter(Boolean).join('\n');
      window.open(`https://wa.me/${whatsapp}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
      success.classList.add('show');
    });
  });
</script>
