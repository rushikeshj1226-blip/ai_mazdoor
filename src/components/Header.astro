---
import Logo from './Logo.astro';
import { nav, serviceLinks, site, waLink } from '@/data/site';
import { cleanPath } from '@/utils/path';

const path = cleanPath(Astro.url.pathname);
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<header class="site-header fixed inset-x-0 top-0 z-50 transition-transform duration-500 ease-(--ease-out-expo)" data-header>
  <div class="header-bg absolute inset-0 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-300"></div>
  <nav class="container-x relative flex h-[4.5rem] items-center justify-between gap-4" aria-label="Main">
    <a href="/" aria-label={`${site.name} — home`} class="rounded-xl">
      <Logo />
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        nav.map((item) =>
          'children' in item ? (
            <li class="group/dd relative">
              <a
                href={item.href}
                class:list={[
                  'flex items-center gap-1 rounded-full px-4 py-2 text-[0.95rem] font-semibold transition-colors hover:bg-orange-tint',
                  isActive(item.href) && 'text-orange-deep',
                ]}
                aria-haspopup="true"
              >
                {item.label}
                <svg class="size-3.5 transition-transform duration-300 group-hover/dd:rotate-180 group-focus-within/dd:rotate-180" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
              <div class="invisible absolute left-1/2 top-full w-[22rem] -translate-x-1/2 translate-y-2 pt-3 opacity-0 transition-all duration-300 ease-(--ease-out-expo) group-hover/dd:visible group-hover/dd:translate-y-0 group-hover/dd:opacity-100 group-focus-within/dd:visible group-focus-within/dd:translate-y-0 group-focus-within/dd:opacity-100">
                <ul class="card-hard p-2 shadow-[6px_6px_0_var(--color-orange)]!">
                  {item.children.map((c, i) => (
                    <li>
                      <a href={c.href} class="group/item flex items-center gap-3 rounded-2xl p-3 transition-colors hover:bg-orange-tint">
                        <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-ink font-mono text-sm font-bold text-orange">0{i + 1}</span>
                        <span class="flex-1">
                          <span class="block font-bold">{c.label} <span class="hi ml-1 text-sm font-semibold text-muted" lang="hi">{c.hi}</span></span>
                          <span class="block text-sm text-muted">{c.note}</span>
                        </span>
                        <span class="arrow text-orange-deep opacity-0 transition-all duration-300 group-hover/item:translate-x-1 group-hover/item:opacity-100" aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                class:list={[
                  'rounded-full px-4 py-2 text-[0.95rem] font-semibold transition-colors hover:bg-orange-tint',
                  isActive(item.href) && 'text-orange-deep',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          )
        )
      }
    </ul>

    <div class="flex items-center gap-2">
      <a href="/contact" class="btn btn-dark hidden min-h-11! px-5! py-2.5! text-[0.95rem]! sm:inline-flex">
        <span class="hi" lang="hi">बात करें</span><span class="opacity-60">·</span>Free call
      </a>
      <button
        type="button"
        class="grid size-11 place-items-center rounded-full border-2 border-ink bg-white lg:hidden"
        popovertarget="mobile-menu"
        aria-label="Open menu"
      >
        <svg class="size-5" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h9" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile menu: native Popover API — accessible, no framework needed -->
<div id="mobile-menu" popover class="mobile-menu">
  <div class="flex h-full flex-col overflow-y-auto bg-paper">
    <div class="container-x flex h-[4.5rem] shrink-0 items-center justify-between">
      <a href="/" aria-label={`${site.name} — home`}><Logo /></a>
      <button type="button" class="grid size-11 place-items-center rounded-full border-2 border-ink bg-orange" popovertarget="mobile-menu" popovertargetaction="hide" aria-label="Close menu">
        <svg class="size-5" viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
      </button>
    </div>
    <nav class="container-x flex flex-1 flex-col gap-1 pb-8 pt-4" aria-label="Mobile">
      <p class="eyebrow mb-1 text-muted">Services · <span lang="hi">सेवाएँ</span></p>
      {
        serviceLinks.map((c, i) => (
          <a href={c.href} class="mm-item flex items-baseline justify-between border-b border-line py-3" style={`--i:${i}`}>
            <span class="text-[1.65rem] font-extrabold tracking-tight">{c.label}</span>
            <span class="hi text-base font-semibold text-orange-deep" lang="hi">{c.hi}</span>
          </a>
        ))
      }
      <div class="mt-6 grid grid-cols-2 gap-2">
        {
          nav.slice(1).map((item, i) => (
            <a href={item.href} class="mm-item rounded-2xl border-2 border-ink bg-white px-4 py-3 text-lg font-bold" style={`--i:${i + 3}`}>
              {item.label}
            </a>
          ))
        }
        <a href="/contact" class="mm-item rounded-2xl border-2 border-ink bg-white px-4 py-3 text-lg font-bold" style="--i:7">Contact</a>
      </div>
      <div class="mt-auto pt-8">
        <a href={waLink()} target="_blank" rel="noopener" class="btn btn-primary w-full">
          WhatsApp पर बात करें <span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="mt-3 text-center text-sm text-muted">{site.hours}</p>
      </div>
    </nav>
  </div>
</div>

<style>
  .header-scrolled .header-bg {
    background: rgb(255 250 245 / 0.82);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-color: var(--color-line);
  }
  .header-hidden {
    transform: translateY(-100%);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    opacity: 0;
    translate: 0 -12px;
    transition: opacity 0.3s, translate 0.45s var(--ease-out-expo), overlay 0.45s allow-discrete, display 0.45s allow-discrete;
  }
  .mobile-menu:popover-open {
    opacity: 1;
    translate: 0 0;
  }
  @starting-style {
    .mobile-menu:popover-open {
      opacity: 0;
      translate: 0 -12px;
    }
  }
  .mobile-menu:popover-open .mm-item {
    animation: pop 0.5s var(--ease-out-expo) both;
    animation-delay: calc(var(--i) * 45ms + 80ms);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    let lastY = window.scrollY;
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      header.classList.toggle('header-scrolled', y > 12);
      // Hide on scroll down, reveal on scroll up
      if (y > 320 && y > lastY + 4) header.classList.add('header-hidden');
      else if (y < lastY - 4 || y < 320) header.classList.remove('header-hidden');
      if (Math.abs(y - lastY) > 4) lastY = y;
      ticking = false;
    };
    update();
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });
  }
  // Close the mobile menu after picking a link
  document.querySelectorAll<HTMLAnchorElement>('#mobile-menu a').forEach((a) =>
    a.addEventListener('click', () => (document.getElementById('mobile-menu') as HTMLElement & { hidePopover(): void })?.hidePopover())
  );
</script>
