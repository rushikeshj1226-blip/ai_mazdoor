---
import { formatDate, readingTime, type Post } from '@/utils/blog';

export interface Props {
  post: Post;
  index?: number;
  featured?: boolean;
}
const { post, index = 0, featured = false } = Astro.props;
const { title, description, hi, category, pubDate } = post.data;
const tone = { 'AI Automation': 'bg-ink text-white', 'Website Design': 'bg-orange text-ink', 'Logo Design': 'bg-orange-soft text-ink' }[category];
---

<article
  class:list={['group relative flex flex-col overflow-hidden rounded-[1.6rem] border-2 border-ink bg-white transition-all duration-500 ease-(--ease-out-expo) hover:-translate-y-1.5 hover:shadow-[8px_8px_0_var(--color-ink)]', featured && 'lg:flex-row']}
  data-reveal
  style={`--d:${index % 3}`}
>
  <div class:list={['relative flex shrink-0 items-end overflow-hidden border-b-2 border-ink p-6', tone, featured ? 'aspect-[16/9] lg:aspect-auto lg:w-1/2 lg:border-r-2 lg:border-b-0' : 'aspect-[16/9]']} aria-hidden="true">
    <p class="display-hi relative z-10 text-[clamp(1.6rem,1.2rem+1.4vw,2.4rem)] transition-transform duration-700 ease-(--ease-out-expo) group-hover:-translate-y-1" lang="hi">{hi}</p>
    <svg class="absolute -top-10 -right-10 size-44 opacity-15 transition-transform duration-1000 ease-(--ease-out-expo) group-hover:rotate-45" viewBox="0 0 40 40"><path d="M20 2c1.6 11.2 6.8 16.4 18 18-11.2 1.6-16.4 6.8-18 18-1.6-11.2-6.8-16.4-18-18 11.2-1.6 16.4-6.8 18-18Z" fill="currentColor" /></svg>
  </div>
  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <p class="eyebrow flex flex-wrap items-center gap-2 text-muted">
      <span class="text-orange-deep">{category}</span> · <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time> · {readingTime(post.body)} min read
    </p>
    <h2 class:list={['mt-3 leading-tight font-extrabold', featured ? 'text-[clamp(1.5rem,1.2rem+1.2vw,2.2rem)]' : 'text-xl']}>
      <a href={`/blog/${post.id}`} class="after:absolute after:inset-0 after:content-['']">{title}</a>
    </h2>
    <p class="mt-3 leading-relaxed text-muted">{description}</p>
    <span class="mt-auto inline-flex items-center gap-2 pt-6 font-bold text-orange-deep">Read article <span class="transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true">→</span></span>
  </div>
</article>
