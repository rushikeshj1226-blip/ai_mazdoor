---
export interface Props {
  steps: { hi: string; title: string; text: string }[];
  dark?: boolean;
}
const { steps, dark = false } = Astro.props;
---

<ol class:list={['grid border-t-2', steps.length === 5 ? 'sm:grid-cols-2 lg:grid-cols-5' : 'sm:grid-cols-2 lg:grid-cols-4', dark ? 'border-white/20' : 'border-ink']}>
  {
    steps.map((s, i) => (
      <li
        class:list={['group relative border-b py-8 pr-6 sm:border-b-0 lg:py-10', i > 0 && 'lg:border-l lg:pl-6', i % 2 === 1 && 'sm:border-l sm:pl-6 lg:pl-6', dark ? 'border-white/15' : 'border-line']}
        data-reveal
        style={`--d:${i}`}
      >
        <span class="step-num block text-[4.2rem] leading-none font-extrabold text-orange transition-transform duration-500 ease-(--ease-spring) group-hover:-translate-y-1 group-hover:rotate-[-4deg]" aria-hidden="true">
          {i + 1}
        </span>
        <h3 class:list={['mt-5 text-xl font-extrabold leading-tight', dark ? 'text-white' : 'text-ink']}>
          <span class="hi" lang="hi">{s.hi}</span> <span class="opacity-40">·</span> {s.title}
        </h3>
        <p class:list={['mt-3 leading-relaxed', dark ? 'text-muted-dark' : 'text-muted']}>{s.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .step-num {
    -webkit-text-stroke: 2px var(--color-ink);
    paint-order: stroke fill;
  }
</style>
